ENV=local
DEBUG=true

POSTGRES_USER=syncscribe
POSTGRES_PASSWORD=syncscribe
POSTGRES_DB=syncscribe
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://syncscribe:syncscribe@postgres:5432/syncscribe

REDIS_URL=redis://redis:6379/0

# SSE Pub/Sub — имя Redis-канала для real-time событий.
# В multi-instance деплое все API-инстансы должны использовать один канал.
REDIS_SSE_CHANNEL=syncscribe:sse

MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=syncscribe
MINIO_ROOT_PASSWORD=syncscribe123
MINIO_BUCKET=syncscribe-documents
MINIO_SECURE=false
MINIO_PRESIGNED_URL_EXPIRE_SECONDS=300

# Минимум 32 символа. Сгенерировать: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me-0000
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

MAX_UPLOAD_SIZE_MB=50

# CORS: один или несколько origins фронтенда через запятую.
# Значение * запрещено: API отдаёт credentials, и подстановочный origin
# открыл бы авторизованные запросы любому сайту.
#   CORS_ALLOWED_ORIGINS=https://app.syncscribe.io,https://staging.syncscribe.io
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# LLM_PROVIDER: stub | remote_http | onprem
# stub    — заглушка для локальной разработки, без реального вызова наружу.
# remote_http — любой внешний HTTP-провайдер инференса.
# onprem  — инференс в контуре заказчика.
LLM_PROVIDER=stub
LLM_ENDPOINT=https://example-llm-endpoint.invalid
LLM_API_KEY=change-me
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

LOG_LEVEL=INFO
LOG_FORMAT=json

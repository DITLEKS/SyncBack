ENV=local
DEBUG=true

POSTGRES_USER=syncscribe
POSTGRES_PASSWORD=syncscribe
POSTGRES_DB=syncscribe
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://syncscribe:syncscribe@postgres:5432/syncscribe

REDIS_URL=redis://redis:6379/0

MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=syncscribe
MINIO_ROOT_PASSWORD=syncscribe123
MINIO_BUCKET=syncscribe-documents
MINIO_SECURE=false
MINIO_PRESIGNED_URL_EXPIRE_SECONDS=300

JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

MAX_UPLOAD_SIZE_MB=50

# LLM_PROVIDER: stub | remote_http | onprem
# stub — заглушка для локальной разработки, без реального вызова наружу.
# remote_http — любой внешний HTTP-провайдер инференса (вендор не зафиксирован в коде,
#   определяется исключительно значениями LLM_ENDPOINT/LLM_API_KEY ниже).
# onprem — инференс в контуре заказчика после подписания NDA.
LLM_PROVIDER=stub
LLM_ENDPOINT=https://example-llm-endpoint.invalid
LLM_API_KEY=change-me
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

LOG_LEVEL=INFO
LOG_FORMAT=json

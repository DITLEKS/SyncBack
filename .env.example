ENV=local
DEBUG=true

POSTGRES_USER=syncscribe
POSTGRES_PASSWORD=syncscribe
POSTGRES_DB=syncscribe
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://syncscribe:syncscribe@postgres:5432/syncscribe

REDIS_URL=redis://redis:6379/0

# SSE Pub/Sub — имя Redis-канала для real-time событий.
# В multi-instance деплое все API-инстансы должны использовать один канал.
REDIS_SSE_CHANNEL=syncscribe:sse

# S3-совместимое хранилище: в compose это SeaweedFS (S3-шлюз на 8333).
# Контейнер seaweedfs читает эти же переменные: создаёт бакет и единственного
# пользователя с правами Read/Write/List только на него. Root-учётки нет.
# Старые имена MINIO_* приложение по-прежнему принимает как алиасы.
S3_ENDPOINT=seaweedfs:8333
S3_ACCESS_KEY=syncscribe-app
S3_SECRET_KEY=change-me-s3-app-secret
S3_BUCKET=syncscribe-documents
S3_SECURE=false
S3_PRESIGNED_URL_EXPIRE_SECONDS=300

# Минимум 32 символа. Сгенерировать: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me-0000
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# Пул соединений API на каждый процесс gunicorn: workers × (size + overflow)
# должно укладываться в max_connections PostgreSQL.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Счётчики rate limit: memory:// только для одного процесса (локально),
# при нескольких воркерах gunicorn — Redis, отдельная база от очереди и SSE.
RATE_LIMIT_STORAGE_URI=redis://redis:6379/1

# Адреса reverse proxy через запятую, чьим X-Forwarded-For можно верить.
# Пусто — заголовок игнорируется. Значение * запрещено.
TRUSTED_PROXY_HOSTS=

MAX_UPLOAD_SIZE_MB=50

# CORS: один или несколько origins фронтенда через запятую.
# Значение * запрещено: API отдаёт credentials, и подстановочный origin
# открыл бы авторизованные запросы любому сайту.
#   CORS_ALLOWED_ORIGINS=https://app.syncscribe.io,https://staging.syncscribe.io
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── LLM ────────────────────────────────────────────────────────────────────────────────────────────
# Один клиент для всех провайдеров: OpenAI-совместимый POST {LLM_ENDPOINT}/chat/completions.
# Смена модели — только эти переменные, код не меняется.
#
# LLM_PROVIDER: stub | openai_compatible
#   stub — заглушка без вызова наружу (локальная разработка без модели, тесты).
#   remote_http / onprem — устаревшие алиасы openai_compatible.
# LLM_AUTH: none | bearer | oauth_gigachat
#
# Пресет 1 — локальная модель (Ollama / vLLM / LM Studio), без ключа:
#   LLM_PROVIDER=openai_compatible
#   LLM_ENDPOINT=http://host.docker.internal:11434/v1
#   LLM_MODEL=qwen2.5:14b
#   LLM_AUTH=none
#
# Пресет 2 — внешний OpenAI-совместимый сервис с API-ключом:
#   LLM_PROVIDER=openai_compatible
#   LLM_ENDPOINT=https://openrouter.ai/api/v1
#   LLM_MODEL=openai/gpt-4o-mini
#   LLM_AUTH=bearer
#   LLM_API_KEY=sk-...
#
# Пресет 3 — GigaChat (Сбер). LLM_API_KEY — «ключ авторизации» из личного кабинета
# (base64 client_id:client_secret), он обменивается на токен автоматически.
# Для TLS нужен корневой сертификат Минцифры: скачайте PEM в папку certs/ репозитория —
# docker-compose монтирует её в backend и worker как /srv/app/certs (read-only).
#   LLM_PROVIDER=openai_compatible
#   LLM_ENDPOINT=https://gigachat.devices.sberbank.ru/api/v1
#   LLM_MODEL=GigaChat
#   LLM_AUTH=oauth_gigachat
#   LLM_API_KEY=<ключ авторизации>
#   LLM_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
#   LLM_OAUTH_SCOPE=GIGACHAT_API_PERS
#   LLM_CA_BUNDLE=/srv/app/certs/russian_trusted_root_ca.pem
LLM_PROVIDER=stub
LLM_ENDPOINT=
LLM_MODEL=
LLM_AUTH=bearer
LLM_API_KEY=
LLM_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
LLM_OAUTH_SCOPE=GIGACHAT_API_PERS
LLM_VERIFY_SSL=true
LLM_CA_BUNDLE=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
# Документ + источник в символах; больше — источник помечается LLM_INPUT_TOO_LARGE
LLM_MAX_INPUT_CHARS=200000

LOG_LEVEL=INFO
LOG_FORMAT=json
